# Server-only settings. Never put API keys in static files or commit .env.
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Optional: Pinecone for company PDFs. Otherwise uses the bundled public profile.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=sawaransoft-chatbot

# Required to enable the admin PDF upload API.
ADMIN_UPLOAD_TOKEN=

COMPANY_NAME=Swaran Soft
COMPANY_ADDRESS=
COMPANY_LATITUDE=
COMPANY_LONGITUDE=
