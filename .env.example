# Copy this file to ".env" and fill in your real values

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=sawaransoft-chatbot

# Ollama (local LLM server - default is fine if running locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.1
OLLAMA_VISION_MODEL=llava

# Company location
COMPANY_NAME=Sawaransoft
COMPANY_ADDRESS=Your Full Office Address, City, State, PIN
COMPANY_LATITUDE=28.4595
COMPANY_LONGITUDE=77.0266
